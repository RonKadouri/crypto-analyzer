# Copy this file to .env and fill in your own keys.
# The real .env is git-ignored and must never be committed.

# CryptoCompare API key for the live Reports page (free).
# Create one at https://developers.coindesk.com/
VITE_CRYPTOCOMPARE_API_KEY=

# OpenAI API key for the AI Recommendations page.
# Create one at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
